<%- include('layouts/head') %>
<p style="margin:0 0 4px 0; font-size:13px; font-weight:600; letter-spacing:0.5px; text-transform:uppercase; color:#ED3131;">Client Availability Confirmed</p>
<h1 style="margin:0 0 16px 0; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">Client has confirmed their appointment attendance</h1>
<p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#52525b;">Hi <%= merchantName %>,</p>
<p style="margin:0 0 24px 0; font-size:15px; line-height:1.6; color:#52525b;">
  Great news! <strong><%= clientName %></strong> has confirmed that they will be attending their upcoming appointment at <strong><%= businessName %></strong>.
</p>
<div style="margin:0 0 24px 0; padding:16px 20px; background-color:#f9fafb; border:1px solid #e4e4e7; border-radius:8px;">
  <p style="margin:0 0 8px 0; font-size:14px; color:#18181b;"><strong>Order Reference:</strong> <%= orderId %></p>
  <p style="margin:0 0 8px 0; font-size:14px; color:#18181b;"><strong>Client:</strong> <%= clientName %></p>
  <p style="margin:0 0 8px 0; font-size:14px; color:#18181b;"><strong>Service:</strong> <%= serviceName %></p>
  <p style="margin:0 0 8px 0; font-size:14px; color:#18181b;"><strong>Date:</strong> <%= date %></p>
  <p style="margin:0; font-size:14px; color:#18181b;"><strong>Time:</strong> <%= time %></p>
</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
          <td style="background-color:#ED3131; border-radius:999px;">
            <a href="<%= frontendUrl %>/merchant/dashboard/appointments" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">View in Appointments</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<p style="margin:0 0 4px 0; font-size:13px; line-height:1.6; color:#a1a1aa;">
  Manage this and other upcoming bookings from your merchant dashboard.
</p>
<%- include('layouts/foot', { frontendUrl, year }) %>
