<%- include('layouts/head') %>
<p style="margin:0 0 4px 0; font-size:13px; font-weight:600; letter-spacing:0.5px; text-transform:uppercase; color:#ED3131;">Platform Invitation</p>
<h1 style="margin:0 0 16px 0; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">You've been invited as <%= roleFormatted %></h1>
<p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#52525b;">Hello,</p>
<p style="margin:0 0 24px 0; font-size:15px; line-height:1.6; color:#52525b;">
  You have been invited to join <strong>Kinky Hairstylist</strong> as <strong><%= roleFormatted %></strong>. Complete your registration using the button below to get started.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="background-color:#FEF2F2; border:1px solid #FBD5D5; border-radius:12px; padding:20px;">
      <p style="margin:0 0 12px 0; font-size:14px; font-weight:700; color:#B91C1C;">Invitation Details:</p>
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr><td style="padding:4px 0; font-size:14px; color:#52525b;"><strong>Email:</strong> <%= to %></td></tr>
        <tr><td style="padding:4px 0; font-size:14px; color:#52525b;"><strong>Assigned Role:</strong> <%= role %></td></tr>
      </table>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 28px 0;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
          <td style="background-color:#ED3131; border-radius:999px;">
            <a href="<%= inviteUrl %>" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">Complete Registration</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin:0 0 4px 0; font-size:13px; line-height:1.6; color:#a1a1aa;">
  This invitation link will expire in 30 minutes. If you did not expect this invitation, you can safely ignore this email.
</p>
<p style="margin:0 0 32px 0; font-size:13px; line-height:1.6; color:#a1a1aa;">
  Need help? Visit our <a href="<%= frontendUrl %>/customer/help" style="color:#ED3131; text-decoration:underline;">Help Center</a>.
</p>
<%- include('layouts/foot', { frontendUrl, year }) %>
