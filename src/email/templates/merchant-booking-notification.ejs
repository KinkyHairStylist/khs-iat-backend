<%- include('layouts/head') %>
<p style="margin:0 0 4px 0; font-size:13px; font-weight:600; letter-spacing:0.5px; text-transform:uppercase; color:#ED3131;">New Paid Booking</p>
<h1 style="margin:0 0 16px 0; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">New appointment booking & payment received</h1>
<p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#52525b;">Hi <%= merchantName %>,</p>
<p style="margin:0 0 20px 0; font-size:15px; line-height:1.6; color:#52525b;">
  You have a new confirmed appointment booking from <strong><%= customerName %></strong> at <strong><%= businessName %></strong>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px 0; background-color:#F9FAFB; border:1px solid #E5E7EB; border-radius:12px; padding:16px;">
  <tr>
    <td>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="padding:6px 0; font-size:14px; color:#6B7280;">Order ID:</td>
          <td align="right" style="padding:6px 0; font-size:14px; font-weight:600; color:#111827;"><%= orderId %></td>
        </tr>
        <tr>
          <td style="padding:6px 0; font-size:14px; color:#6B7280;">Service(s):</td>
          <td align="right" style="padding:6px 0; font-size:14px; font-weight:600; color:#111827;"><%= serviceName %></td>
        </tr>
        <tr>
          <td style="padding:6px 0; font-size:14px; color:#6B7280;">Date & Time:</td>
          <td align="right" style="padding:6px 0; font-size:14px; font-weight:600; color:#111827;"><%= date %> at <%= time %></td>
        </tr>
        <tr>
          <td style="padding:6px 0; font-size:14px; color:#6B7280;">Customer:</td>
          <td align="right" style="padding:6px 0; font-size:14px; font-weight:600; color:#111827;"><%= customerName %></td>
        </tr>
        <tr style="border-top:1px solid #E5E7EB;">
          <td style="padding:8px 0 0 0; font-size:15px; font-weight:700; color:#111827;">Amount Paid:</td>
          <td align="right" style="padding:8px 0 0 0; font-size:16px; font-weight:700; color:#ED3131;"><%= amountPaid %></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
          <td style="background-color:#ED3131; border-radius:999px;">
            <a href="<%= frontendUrl %>/merchant/dashboard/bookings" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">View in Merchant Dashboard</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<%- include('layouts/foot', { frontendUrl, year }) %>
