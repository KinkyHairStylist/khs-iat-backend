# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4110
# Cluster fork count. Leave unset (defaults to 1) on containerized PaaS hosts.
# WEB_CONCURRENCY=1

# ─── Database ───────────────────────────────────────────────────────────────
# The SAME Postgres database as Kinky-Hair-Stylist-BE-Redesign (its DB_HOST,
# DB_PORT, DB_USERNAME, DB_PASSWORD, DB_DATABASE combined into one URL).
# Add ?sslmode=require when that backend runs with DB_SSL=require.
# That backend owns the schema — never run prisma migrate / db push here.
DATABASE_URL=postgresql://postgres:password@localhost:5432/kinky_hair_stylist

# ─── Auth / sessions ────────────────────────────────────────────────────────
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Tokens only ever live in httpOnly cookies.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Empty = host-only cookies. Set to the parent domain (".kinkyhairstylists.com")
# when the customer app and API are on different subdomains.
COOKIE_DOMAIN=
# strict | lax | none — "none" only for a cross-site deployment (needs COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
# Defaults to true outside development
# COOKIE_SECURE=true

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins of khs-iat-customer-fe
CORS_ORIGIN=http://localhost:3000

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Redis ──────────────────────────────────────────────────────────────────
# rediss://:TOKEN@host:6379 for TLS providers (Upstash, etc.), redis:// for local
REDIS_URL=redis://localhost:6379

# ─── API docs ───────────────────────────────────────────────────────────────
# Swagger UI + spec.json at /docs. Defaults to off in production.
ENABLE_API_DOCS=true

# ─── App URLs (email links) ─────────────────────────────────────────────────
# khs-iat-customer-fe origin
CUSTOMER_APP_URL=http://localhost:3000

# ─── SendGrid (email) ───────────────────────────────────────────────────────
# Same account/sender as Kinky-Hair-Stylist-BE-Redesign
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Kinky Hair Stylist
# Client emails one salon can send a day (messages, reminders, promotions).
CLIENT_MESSAGES_PER_DAY=500
# KHS team mailbox: told about new customers, copied on welcome emails (never on
# emails carrying a code). Leave empty for none.
DELIVERY_TEAM_EMAIL=
SUPPORT_EMAIL=support@kinkyhairstylists.com

# ─── Slack alerts ───────────────────────────────────────────────────────────
# Leave SLACK_CHANNEL_ID empty to turn alerts off
SLACK_USERS_TOKEN=
SLACK_CHANNEL_ID=
# Label put in front of each alert, e.g. iat, sit, uat, prod
APP_ENV=

# ─── Money ──────────────────────────────────────────────────────────────────
# Platform currency (ISO 4217); every amount shown to customers uses it
CURRENCY=AUD
# What a referrer earns (in CURRENCY) when someone they referred signs up
REFERRAL_REWARD_AMOUNT=20

# ─── Support chat ───────────────────────────────────────────────────────────
# Same Redis as khs-iat-staff-be's CHAT_BRIDGE_REDIS_URL (customer messages
# reach staff on it, staff replies come back). Empty = REDIS_URL.
CHAT_BRIDGE_REDIS_URL=
# Firebase Storage for chat images (same service account/bucket as the staff
# backend). Empty = text-only chat.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ─── Payments ───────────────────────────────────────────────────────────────
# Same Stripe account as the Kinky-Hair-Stylist backend. Empty = card
# payments answer 503.
STRIPE_SECRET_KEY=
# Stripe webhook endpoint → POST /api/v1/webhooks/stripe (signing secret whsec_...)
STRIPE_WEBHOOK_SECRET=
# The salons' dashboard (linked from the salon's "new booking" email)
MERCHANT_APP_URL=http://localhost:3005

# ─── Merchant payouts ──────────────────────────────────────────────────────────
# Salons withdraw their wallet balance; KHS reviews each request. With a connected
# Stripe (Australia) or Airwallex (other countries) account the salon sends an
# approved payout to itself; otherwise KHS pays by hand.
STRIPE_CONNECT_ENABLED=false
AIRWALLEX_ENABLED=false
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# https://api.airwallex.com in production
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
# currencyapi.com key — converts withdrawals into the payout account's currency
CURRENCY_API_KEY=
# Airwallex webhook → POST /api/v1/webhooks/airwallex
AIRWALLEX_WEBHOOK_SECRET=

# Scheduled jobs. Keep false until the Kinky-Hair-Stylist backend's crons are switched off.
JOBS_ENABLED=false
PLATFORM_TIME_ZONE=Australia/Sydney
